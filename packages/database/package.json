{
  "name": "@devlens/database",
  "version": "0.1.0",
  "description": "DevLens persistence infrastructure (in-memory + PostgreSQL/Drizzle adapters)",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push"
  },
  "dependencies": {
    "@devlens/application": "workspace:*",
    "@devlens/core": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.9"
  },
  "type": "module",
  "devDependencies": {
    "@devlens/detectors": "workspace:*",
    "drizzle-kit": "^0.31.10"
  }
}
